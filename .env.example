# Environment variables for docker-compose.yml.
# Copy this file to .env and change what you need: cp .env.example .env
# Not required: every variable has a default in docker-compose.yml.
# .env is git-ignored. Never commit it, and never put real passwords in this file.

# PostgreSQL (service "db")
POSTGRES_DB=alumni
POSTGRES_USER=alumni
POSTGRES_PASSWORD=alumni

# Ports on your computer. NestJS always listens on 3000 inside Docker.
# Set BACKEND_PORT=3111 to use http://localhost:3111 for the full application.
DB_PORT=5432
BACKEND_PORT=3000

# Use a different volume name for an independent checkout.
# Keep this value stable to reopen the same database.
DB_VOLUME=alumni-db-data

# First admin account (week 9). Created on startup when both are set, as ACTIVE
# ADMIN, if the e-mail has no account yet; it can then log in at /login and approve
# new accounts. This is a synthetic local value: choose your own before sharing a server.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=local-admin-password

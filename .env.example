# Environment variables for docker-compose.yml.
# Copy this file to .env and change what you need: cp .env.example .env
# Not required: every variable has a default in docker-compose.yml.
# .env is git-ignored. Never commit it, and never put real passwords in this file.

# PostgreSQL (service "db")
POSTGRES_DB=alumni
POSTGRES_USER=alumni
POSTGRES_PASSWORD=alumni

# Ports on your computer. Change one if it is already taken.
DB_PORT=5432
BACKEND_PORT=3000

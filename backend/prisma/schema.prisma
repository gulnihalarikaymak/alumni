// The database schema of ATS. It implements the tables in DDD.md:
// change both in the same commit. Models use camelCase in TypeScript and
// @map / @@map give the snake_case names the tables have in PostgreSQL.
// After a change: `npx prisma migrate dev --name <what-changed>` (see README).

datasource db {
  provider = "postgresql"
}

// Generates the typed Prisma Client into src/generated/prisma (git-ignored).
// Run `npx prisma generate` after every change to this file.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum Role {
  ADMIN
  STAFF
  ALUMNI
  STUDENT
}

enum Status {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum WorkType {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  ACCEPTED
  REJECTED
}

// In code since week 3 (in memory until week 5)
model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique // stored lower-case by UsersService
  role               Role
  status             Status              @default(PENDING)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  alumniProfile      AlumniProfile?
  eventRegistrations EventRegistration[]
  jobApplications    JobApplication[]

  @@map("users")
}

// In code since homework 1 (in memory until week 5)
model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(120)
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("announcements")
}

// Planned for week 7: the tables exist, the code does not use them yet
model AlumniProfile {
  id               Int              @id @default(autoincrement())
  userId           Int              @unique @map("user_id")
  fullName         String           @map("full_name")
  graduationYear   Int              @map("graduation_year")
  city             String? // city level only, no street address
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerEntries    CareerEntry[]
  educationEntries EducationEntry[]

  @@map("alumni_profiles")
}

model CareerEntry {
  id              Int           @id @default(autoincrement())
  alumniProfileId Int           @map("alumni_profile_id")
  company         String
  position        String
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date // empty = current job
  alumniProfile   AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@map("career_entries")
}

model EducationEntry {
  id              Int           @id @default(autoincrement())
  alumniProfileId Int           @map("alumni_profile_id")
  institution     String
  degree          String
  graduationYear  Int           @map("graduation_year")
  alumniProfile   AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  @@map("education_entries")
}

model Event {
  id            Int                 @id @default(autoincrement())
  title         String
  description   String?
  startsAt      DateTime            @map("starts_at") @db.Timestamptz
  location      String?
  capacity      Int? // empty = no limit
  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId]) // a user registers once per event
  @@map("event_registrations")
}

model JobPosting {
  id             Int              @id @default(autoincrement())
  title          String           @db.VarChar(120)
  company        String
  location       String? // city level; empty = not stated
  workType       WorkType         @map("work_type")
  employmentType EmploymentType   @map("employment_type")
  description    String
  applyUrl       String?          @map("apply_url") // empty = apply in ATS (job_applications)
  deadline       DateTime?        @db.Date // empty = open until removed
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  applications   JobApplication[]

  @@map("job_postings")
}

model JobApplication {
  id           Int               @id @default(autoincrement())
  jobPostingId Int               @map("job_posting_id")
  applicantId  Int               @map("applicant_id")
  coverLetter  String?           @map("cover_letter") // empty = none
  status       ApplicationStatus @default(SUBMITTED)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  jobPosting   JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  applicant    User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, applicantId]) // a user applies once per posting
  @@map("job_applications")
}

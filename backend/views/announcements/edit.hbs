{{!-- UPDATE: GET /announcements/:id/edit shows it; PUT /announcements/:id renders it again when the input is rejected.
      Data: announcement, values (stored or typed), errors --}}
<div class="narrow">
  <a class="back" href="/announcements/{{announcement.id}}">Back to the announcement</a>
  <div class="page-head">
    <div>
      <h1>Edit announcement #{{announcement.id}}</h1>
      <p class="sub">Change the fields and save.</p>
    </div>
  </div>
  <div class="card">
    {{> errors}}
    <form class="stack" method="post" action="/announcements/{{announcement.id}}?_method=PUT">
      <label>Title
        <input type="text" name="title" value="{{values.title}}" maxlength="120" required autofocus>
      </label>
      <label>Content
        <textarea name="content" rows="6" maxlength="2000" required>{{values.content}}</textarea>
      </label>
      <div class="form-actions">
        <button class="btn" type="submit">Save changes</button>
        <a class="btn quiet" href="/announcements/{{announcement.id}}">Cancel</a>
      </div>
    </form>
  </div>
</div>

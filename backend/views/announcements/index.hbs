{{!-- READ all: GET /announcements. Data: announcements (newest first) --}}
<div class="page-head">
  <div>
    <h1>Announcements</h1>
    <p class="sub">{{announcements.length}} {{#if (same announcements.length 1)}}announcement{{else}}announcements{{/if}}, newest first</p>
  </div>
  <a class="btn" href="/announcements/create">New announcement</a>
</div>

{{#if announcements.length}}
  <ol class="entries">
    {{#each announcements}}
      <li>
        <h3><a href="/announcements/{{id}}">{{title}}</a></h3>
        <time datetime="{{createdAt}}">{{date createdAt}}</time>
        <p>{{excerpt content 160}}</p>
        <div class="actions">
          <a href="/announcements/{{id}}/edit">Edit</a>
          <form method="post" action="/announcements/{{id}}?_method=DELETE" onsubmit="return confirm('Delete this announcement?')">
            <button class="link danger" type="submit">Delete</button>
          </form>
        </div>
      </li>
    {{/each}}
  </ol>
{{else}}
  <p class="empty">No announcements yet. <a href="/announcements/create">Write the first one</a>.</p>
{{/if}}

<p class="foot">Kept in memory: restarting the server empties this list. The same data as JSON: <a href="/api/announcements">/api/announcements</a></p>

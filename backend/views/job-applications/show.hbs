{{!-- READ one: GET /job-applications/:id; also PATCH /job-applications/:id when the change is rejected.
      Data: application (with posting and applicant), statuses, values (stored or typed), errors --}}
<a class="back" href="/job-postings/{{application.jobPosting.id}}/applications">All applications to this posting</a>
<div class="page-head">
  <div class="profile">
    <span class="initial" aria-hidden="true">{{application.applicant.email}}</span>
    <div>
      <h1>{{application.applicant.email}}</h1>
      <p class="sub">Application #{{application.id}} to <a href="/job-postings/{{application.jobPosting.id}}">{{application.jobPosting.title}}</a></p>
    </div>
  </div>
  <div class="actions">
    <form method="post" action="/job-applications/{{application.id}}?_method=DELETE" onsubmit="return confirm('Withdraw this application?')">
      <button class="btn danger" type="submit">Withdraw</button>
    </form>
  </div>
</div>

<div class="split">
  <section class="card">
    <h2>Details</h2>
    <dl class="record">
      <dt>Status</dt><dd><span class="badge {{application.status}}">{{application.status}}</span></dd>
      <dt>Job posting</dt><dd><a href="/job-postings/{{application.jobPosting.id}}">{{application.jobPosting.title}}</a>, {{application.jobPosting.company}}</dd>
      <dt>Applicant</dt><dd><a href="/users/{{application.applicant.id}}">{{application.applicant.email}}</a> <span class="badge role">{{application.applicant.role}}</span></dd>
      <dt>Applied</dt><dd><time datetime="{{application.createdAt}}">{{date application.createdAt}}</time></dd>
      <dt>Updated</dt><dd><time datetime="{{application.updatedAt}}">{{date application.updatedAt}}</time></dd>
      <dt>Cover letter</dt><dd>{{#if application.coverLetter}}<p class="content" style="font-size:15px">{{application.coverLetter}}</p>{{else}}<span class="sub">None</span>{{/if}}</dd>
    </dl>
  </section>

  <section class="card">
    <h2>Update</h2>
    {{> errors}}
    <form class="stack" method="post" action="/job-applications/{{application.id}}?_method=PATCH">
      <label>Status
        <select name="status" required>
          {{#each statuses}}
            <option value="{{this}}" {{#if (same this ../values.status)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </label>
      <label>Cover letter
        <textarea name="coverLetter" rows="5" maxlength="2000">{{values.coverLetter}}</textarea>
      </label>
      <div class="form-actions"><button class="btn" type="submit">Save</button></div>
    </form>
  </section>
</div>

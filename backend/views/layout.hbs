<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} — ATS İÜ</title>
  <link rel="icon" href="/emblem.svg" type="image/svg+xml">
  <script>
    try {
      const saved = localStorage.getItem('theme');
      document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved :
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch {}
  </script>
  <link rel="stylesheet" href="/workspace.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site">
    <div class="bar">
      <a class="brand" href="/" aria-label="ATS İÜ Alumni Network, home">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>ATS <span lang="tr">İÜ</span><small>Alumni Network</small></span>
      </a>
      <button class="workspace-menu" type="button" aria-controls="workspace-nav" aria-expanded="false" hidden>Menu</button>
      <nav class="nav" id="workspace-nav" aria-label="Platform">
        <a href="/platform" {{navCurrent "/platform"}}>Workspace</a>
        <a href="/job-postings" {{navCurrent "/job-postings"}}>Opportunities</a>
        <a href="/announcements" {{navCurrent "/announcements"}}>Announcements</a>
        <a href="/job-applications" {{navCurrent "/job-applications"}}>Applications</a>
        <a href="/users" {{navCurrent "/users"}}>Users</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch theme" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"/>
        </svg>
      </button>
    </div>
  </header>
  <main id="main" tabindex="-1">
    {{{body}}}
  </main>
  <footer class="site-foot">
    <a href="/" lang="tr">İstanbul Üniversitesi</a>
    <nav aria-label="Additional resources"><a href="/about">About</a><a href="/api/swagger">API docs</a><a href="/api/health">System status</a></nav>
  </footer>
  <script>
    const themeButton = document.querySelector('.theme-toggle');
    const themeRoot = document.documentElement;
    function setThemeLabel() {
      themeButton.setAttribute('aria-label', themeRoot.dataset.theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    }
    themeButton.hidden = false;
    setThemeLabel();
    themeButton.addEventListener('click', () => {
      themeRoot.dataset.theme = themeRoot.dataset.theme === 'dark' ? 'light' : 'dark';
      setThemeLabel();
      try { localStorage.setItem('theme', themeRoot.dataset.theme); } catch {}
    });
    const menuButton = document.querySelector('.workspace-menu');
    const compact = matchMedia('(max-width: 56rem)');
    function setMenu(open) {
      menuButton.hidden = !compact.matches;
      document.querySelector('#workspace-nav').hidden = compact.matches && !open;
      menuButton.setAttribute('aria-expanded', String(open));
    }
    setMenu(false);
    compact.addEventListener('change', () => setMenu(false));
    menuButton.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        menuButton.focus();
      }
    });
  </script>
</body>
</html>

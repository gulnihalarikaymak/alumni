<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ATS - {{title}}</title>
  <style>
    :root {
      --bg: #f4f4f9; --card: #ffffff; --text: #2c3e50; --muted: #7f8c8d; --line: #e6e8ee;
      --link: #3498db; --danger: #c0392b; --danger-soft: #fbeaea; --soft: #eef3fb;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #12151c; --card: #1b1f29; --text: #e6e9ef; --muted: #9aa3b2; --line: #2a3040;
        --link: #5dade2; --danger: #ff6b5e; --danger-soft: #3a1f1d; --soft: #222a38;
      }
    }
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; margin: 0; background: var(--bg); color: var(--text); }
    nav { display: flex; flex-wrap: wrap; gap: 16px; padding: 14px 16px; max-width: 860px; margin: 0 auto; font-size: .9rem; }
    nav strong { margin-right: auto; }
    a { color: var(--link); text-decoration: none; }
    a:hover { text-decoration: underline; }
    main { max-width: 860px; margin: 0 auto 32px; padding: 24px; background: var(--card); border-radius: 12px; box-shadow: 0 6px 24px rgba(0,0,0,0.08); }
    h1 { font-size: 1.35rem; margin: 0 0 4px; }
    h2 { font-size: 1.05rem; margin: 28px 0 12px; }
    .sub { color: var(--muted); margin: 0 0 20px; font-size: .9rem; }
    table { width: 100%; border-collapse: collapse; font-size: .92rem; }
    th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); }
    th { color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .04em; }
    .table-wrap { overflow-x: auto; }
    .tag { display: inline-block; padding: 2px 8px; border-radius: 999px; background: var(--soft); font-size: .8rem; font-weight: 600; }
    dl { display: grid; grid-template-columns: 140px 1fr; gap: 10px 16px; margin: 0 0 24px; }
    dt { color: var(--muted); }
    dd { margin: 0; word-break: break-word; }
    form.stack { display: grid; gap: 16px; max-width: 420px; }
    form.inline { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
    form.inline label { flex: 1 1 200px; }
    label { display: grid; gap: 6px; font-weight: 600; font-size: .9rem; }
    input, select, textarea { font: inherit; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--card); color: var(--text); }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
    .btn { font: inherit; display: inline-block; padding: 8px 16px; border-radius: 6px; border: 0; background: var(--link); color: #fff; cursor: pointer; }
    .btn:hover { text-decoration: none; opacity: .9; }
    .btn.danger { background: var(--danger); }
    .link { font: inherit; background: none; border: 0; padding: 0; color: var(--link); cursor: pointer; }
    .link.danger { color: var(--danger); }
    .link:hover { text-decoration: underline; }
    td .actions { gap: 14px; }
    .errors { background: var(--danger-soft); color: var(--danger); border-radius: 8px; padding: 12px 16px 12px 32px; margin: 0 0 16px; }
    .empty { color: var(--muted); padding: 24px 0; }
    textarea { resize: vertical; }
    .content { white-space: pre-wrap; line-height: 1.55; margin: 0; }
    .foot { color: var(--muted); font-size: .8rem; margin: 20px 0 0; }
    @media (max-width: 520px) { dl { grid-template-columns: 1fr; gap: 2px; } dd { margin-bottom: 10px; } main { padding: 16px; border-radius: 0; } }
  </style>
</head>
<body>
  <nav>
    <strong>Alumni Tracking System</strong>
    <a href="/">Home</a>
    <a href="/users">Users</a>
    <a href="/users/create">New user</a>
    <a href="/announcements">Announcements</a>
    <a href="/api/swagger">API docs</a>
  </nav>
  <main>
{{{body}}}
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script>
    // Apply a saved theme before the page is drawn, so it does not flash.
    try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <title>{{title}} – Alumni Tracking System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --page: #edf0f4; --surface: #ffffff; --ink: #1b2440; --on-ink: #e7ebf3; --on-ink-muted: #a9b3c8;
      --text: #1e2433; --muted: #5d6678; --line: #dce1e8; --row: #f5f7fa;
      --accent: #2c5aa0; --accent-ink: #9dbbea; --on-accent: #ffffff;
      --danger: #b3261e; --danger-soft: #fbeceb;
      --serif: "Literata", Georgia, serif;
      --sans: "Public Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    /* Dark theme: follows the system unless the theme button chose one (data-theme on <html>) */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --page: #10141c; --surface: #171c26; --ink: #1a2238; --on-ink: #e4e8ef; --on-ink-muted: #8d97ab;
        --text: #e4e8ef; --muted: #98a2b3; --line: #2a3242; --row: #1d2330;
        --accent: #7fa7e6; --accent-ink: #7fa7e6; --on-accent: #0f1626;
        --danger: #f28b82; --danger-soft: #3a2220;
      }
    }
    :root[data-theme="dark"] {
      --page: #10141c; --surface: #171c26; --ink: #1a2238; --on-ink: #e4e8ef; --on-ink-muted: #8d97ab;
      --text: #e4e8ef; --muted: #98a2b3; --line: #2a3242; --row: #1d2330;
      --accent: #7fa7e6; --accent-ink: #7fa7e6; --on-accent: #0f1626;
      --danger: #f28b82; --danger-soft: #3a2220;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--page); color: var(--text); font: 400 1rem/1.55 var(--sans); }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; text-underline-offset: 3px; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

    /* Header: the one strong element on the page */
    header.site { background: var(--ink); color: var(--on-ink); }
    header.site .inner { max-width: 920px; margin: 0 auto; padding: 18px 16px 0; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 8px 32px; }
    .brand { font: 600 1.3rem/1.2 var(--serif); color: var(--on-ink); padding-bottom: 16px; margin-right: auto; }
    .brand:hover { text-decoration: none; }
    .brand small { display: block; font: 400 .8rem/1.4 var(--sans); color: var(--on-ink-muted); margin-top: 2px; }
    nav.main { display: flex; gap: 4px; }
    nav.main a { color: var(--on-ink-muted); padding: 8px 12px 14px; border-bottom: 3px solid transparent; font-weight: 500; font-size: .95rem; }
    nav.main a:hover { color: var(--on-ink); text-decoration: none; }
    nav.main a[aria-current="page"] { color: var(--on-ink); border-bottom-color: var(--accent-ink); }
    .theme-toggle { align-self: center; margin-bottom: 12px; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; background: transparent; color: var(--on-ink-muted); cursor: pointer; }
    .theme-toggle:hover { color: var(--on-ink); border-color: rgba(255,255,255,.35); }
    .theme-toggle svg { width: 18px; height: 18px; }
    .theme-toggle .sun { display: none; }
    :root[data-theme="dark"] .theme-toggle .sun { display: block; }
    :root[data-theme="dark"] .theme-toggle .moon { display: none; }

    main { max-width: 920px; margin: 28px auto 48px; padding: 28px 32px 32px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
    h1 { font: 600 1.75rem/1.2 var(--serif); margin: 0 0 6px; letter-spacing: -.01em; }
    h2 { font: 600 1.15rem/1.3 var(--serif); margin: 32px 0 12px; }
    .sub { color: var(--muted); margin: 0 0 24px; font-size: .92rem; }
    .page-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px 24px; margin-bottom: 8px; }
    .page-head .sub { margin-bottom: 16px; }

    /* Tables (users) */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .94rem; }
    th, td { text-align: left; padding: 11px 10px; border-bottom: 1px solid var(--line); }
    th { color: var(--muted); font-size: .82rem; font-weight: 600; }
    tbody tr:hover { background: var(--row); }
    .tag { display: inline-block; padding: 1px 9px; border-radius: 999px; border: 1px solid var(--line); font-size: .78rem; font-weight: 600; color: var(--muted); }

    /* Announcement list */
    ol.entries { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    ol.entries li { display: grid; grid-template-columns: 1fr auto; gap: 4px 24px; padding: 18px 0; border-bottom: 1px solid var(--line); }
    ol.entries h3 { font: 600 1.12rem/1.35 var(--serif); margin: 0; }
    ol.entries time { color: var(--muted); font-size: .85rem; }
    ol.entries p { grid-column: 1; margin: 2px 0 0; color: var(--muted); max-width: 68ch; }
    ol.entries .actions { grid-column: 2; grid-row: 1 / span 3; align-self: start; font-size: .9rem; }

    /* Detail pages */
    dl { display: grid; grid-template-columns: 140px 1fr; gap: 10px 16px; margin: 0 0 24px; }
    dt { color: var(--muted); }
    dd { margin: 0; word-break: break-word; }
    .content { white-space: pre-wrap; line-height: 1.7; margin: 0; max-width: 68ch; font-size: 1.04rem; }

    /* Forms and buttons */
    form.stack { display: grid; gap: 18px; max-width: 520px; }
    form.inline { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
    form.inline label { flex: 1 1 200px; }
    label { display: grid; gap: 6px; font-weight: 600; font-size: .9rem; }
    input, select, textarea { font: inherit; font-weight: 400; padding: 9px 11px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--text); }
    input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }
    textarea { resize: vertical; min-height: 140px; }
    .actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
    .actions form { margin: 0; }
    .btn { font: 600 .92rem/1 var(--sans); display: inline-block; padding: 11px 18px; border-radius: 6px; border: 1px solid transparent; background: var(--accent); color: var(--on-accent); cursor: pointer; }
    .btn:hover { text-decoration: none; filter: brightness(1.08); }
    .btn.quiet { background: transparent; border-color: var(--line); color: var(--text); }
    .btn.danger { background: transparent; border-color: var(--danger); color: var(--danger); }
    .link { font: inherit; background: none; border: 0; padding: 0; color: var(--accent); cursor: pointer; }
    .link.danger { color: var(--danger); }
    .link:hover { text-decoration: underline; text-underline-offset: 3px; }
    .errors { background: var(--danger-soft); color: var(--danger); border-radius: 8px; padding: 12px 16px 12px 34px; margin: 0 0 18px; }
    .empty { color: var(--muted); padding: 28px 0; border-top: 1px solid var(--line); margin: 0; }
    .foot { color: var(--muted); font-size: .82rem; margin: 24px 0 0; }

    /* Home page */
    .home h1 { font-size: clamp(1.9rem, 4.5vw, 2.6rem); line-height: 1.15; max-width: 22ch; margin-bottom: 14px; }
    .home .lead { color: var(--muted); font-size: 1.08rem; max-width: 60ch; margin: 0 0 32px; }
    ul.destinations { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); border-top: 1px solid var(--line); }
    ul.destinations li { padding: 20px 24px 22px 0; border-bottom: 1px solid var(--line); }
    ul.destinations a { font: 600 1.2rem/1.3 var(--serif); }
    ul.destinations p { margin: 6px 0 0; color: var(--muted); font-size: .94rem; }

    @media (max-width: 560px) {
      main { margin: 0; border-radius: 0; border-width: 0 0 1px; padding: 22px 16px; }
      header.site .inner { padding-top: 14px; }
      nav.main { order: 3; width: 100%; }
      .theme-toggle { margin-bottom: 14px; }
      nav.main a { padding: 8px 10px 12px; }
      dl { grid-template-columns: 1fr; gap: 2px; } dd { margin-bottom: 10px; }
      ol.entries li { grid-template-columns: 1fr; }
      ol.entries .actions { grid-column: 1; grid-row: auto; margin-top: 8px; }
    }
  </style>
</head>
<body>
  <header class="site">
    <div class="inner">
      <a class="brand" href="/">Alumni Tracking System<small>Istanbul University graduates and students</small></a>
      <nav class="main" aria-label="Main">
        <a href="/announcements" {{navCurrent "/announcements"}}>Announcements</a>
        <a href="/users" {{navCurrent "/users"}}>Users</a>
        <a href="/api/swagger">API docs</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch theme">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </header>
  <main>
{{{body}}}
  </main>
  <script>
    // Theme button: switches between light and dark and remembers the choice in this browser.
    (function () {
      const root = document.documentElement;
      const button = document.querySelector(".theme-toggle");
      const current = () => root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      const show = (t) => { root.dataset.theme = t; button.setAttribute("aria-label", t === "dark" ? "Switch to light theme" : "Switch to dark theme"); };
      show(current());
      button.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        show(next);
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    })();
  </script>
</body>
</html>

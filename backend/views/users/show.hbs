{{!-- READ one: GET /users/:id; also PATCH /users/:id when the status change is rejected.
      Data: user, statuses, errors --}}
<a class="back" href="/users">All users</a>
<div class="page-head">
  <div class="profile">
    <span class="initial" aria-hidden="true">{{user.email}}</span>
    <div>
      <h1>{{user.email}}</h1>
      <p class="sub">User #{{user.id}}</p>
    </div>
  </div>
  <div class="actions">
    <a class="btn quiet" href="/users/{{user.id}}/edit">Edit</a>
    <form method="post" action="/users/{{user.id}}?_method=DELETE" onsubmit="return confirm('Delete this user?')">
      <button class="btn danger" type="submit">Delete</button>
    </form>
  </div>
</div>

<div class="split">
  <section class="card">
    <h2>Details</h2>
    <dl class="record">
      <dt>Id</dt><dd>{{user.id}}</dd>
      <dt>E-mail</dt><dd>{{user.email}}</dd>
      <dt>Role</dt><dd><span class="badge role">{{user.role}}</span></dd>
      <dt>Status</dt><dd><span class="badge {{user.status}}">{{user.status}}</span></dd>
      <dt>Created</dt><dd><time datetime="{{user.createdAt}}">{{date user.createdAt}}</time></dd>
    </dl>
  </section>

  <section class="card">
    <h2>Change status</h2>
    {{> errors}}
    <form class="stack" method="post" action="/users/{{user.id}}?_method=PATCH">
      <label>Status
        <select name="status" required>
          {{#each statuses}}
            <option value="{{this}}" {{#if (same this ../user.status)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select>
      </label>
      <div class="form-actions"><button class="btn" type="submit">Save status</button></div>
    </form>
  </section>
</div>
